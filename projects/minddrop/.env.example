APP_NAME=MindDrop
APP_SECRET=change-this-to-a-long-random-string
DATA_DIR=/data
ALLOW_SIGNUP=true
INVITE_CODE=change-me
INTAKE_TOKEN=change-this-intake-token

# Optional: any OpenAI-compatible local LLM endpoint.
# Ollama usually works with http://host.docker.internal:11434/v1
LLM_API_BASE=
LLM_API_KEY=local
LLM_MODEL=llama3.1
